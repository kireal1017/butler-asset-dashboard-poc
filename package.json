{
  "name": "butler-asset-dashboard-poc",
  "private": true,
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev -w server\" \"npm:dev -w client\"",
    "test": "npm test -w server && npm test -w client",
    "m0": "node scripts/m0-probe.mjs",
    "verify": "node verify/check-imports.mjs && node verify/recompute.mjs",
    "e2e": "node verify/e2e-v3.mjs && node verify/recompute.mjs --dom verify/out/dom.json",
    "scan-secrets": "node verify/scan-secrets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
